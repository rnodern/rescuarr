[Unit]
Description=Rescuarr
After=network.target

[Service]
User=rescuarr
Group=rescuarr
ExecStart=/usr/local/bin/rescuarr serve --data-dir /var/lib/rescuarr
EnvironmentFile=-/etc/rescuarr/rescuarr.env
StateDirectory=rescuarr
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
