{{define "review"}}
{{template "start" .}}
<p><a href="{{.Base}}/cases/{{.Body.Proposal.CaseID}}">Back to case {{.Body.Proposal.CaseID}}</a></p>
<h1>{{.Title}}</h1>
{{if .Body.Hold}}<p class="notice">{{.Body.Hold}}</p>{{end}}
<div class="case-grid">
  <section class="panel">
    <h2>Planned effects</h2>
    {{if .Body.Proposal.Operation.Effects}}<ul class="links">{{range .Body.Proposal.Operation.Effects}}<li>{{effect .Kind}}<span>{{target .Target}}</span></li>{{end}}</ul>
    {{else}}<p>Effect information is unavailable.</p>{{end}}
  </section>
  <section class="panel">
    <h2>Eligibility</h2>
    {{if .Body.Proposal.Guards}}<ul class="links">{{range .Body.Proposal.Guards}}<li>{{reason .Reason}}<span>{{if .Passed}}Passed{{else}}Held{{end}}</span>
      {{if .Evidence}}<details><summary>Evidence references</summary><ul>{{range .Evidence}}<li>{{.}}</li>{{end}}</ul></details>{{end}}
    </li>{{end}}</ul>{{else}}<p>Eligibility evidence is unavailable.</p>{{end}}
    <dl><dt>Approval deadline</dt><dd>{{when .Body.Proposal.ExpiresAt}}</dd>
      <dt>Case revision</dt><dd>{{.Body.Proposal.CaseRevision}}</dd>
      <dt>Policy revision</dt><dd>{{.Body.Proposal.PolicyRevision}}</dd>
      <dt>Capability revision</dt><dd>{{.Body.Proposal.CapabilityRevision}}</dd></dl>
  </section>
</div>
{{if .Body.RequestKey}}
<form class="section" action="{{.Base}}/cases/{{.Body.Proposal.CaseID}}/actions" method="post" data-approval>
  <input type="hidden" name="proposal_id" value="{{.Body.Proposal.ID}}">
  <input type="hidden" name="revision" value="{{.Body.Proposal.CaseRevision}}">
  <input type="hidden" name="request_key" value="{{.Body.RequestKey}}">
  <input type="hidden" name="csrf" value="{{.Body.CSRF}}">
  <button type="submit">Queue {{action .Body.Proposal.Operation.Action}}</button>
</form>
{{end}}
{{template "end" .}}
{{end}}

{{define "intent"}}
{{template "start" .}}
<p><a href="{{.Base}}/cases/{{.Body.Proposal.CaseID}}">Back to case {{.Body.Proposal.CaseID}}</a></p>
<h1>{{.Title}}</h1>
<p>{{intent .Body.State}}</p>
<section class="panel section">
  <h2>Requested {{action .Body.Proposal.Operation.Action}}</h2>
  <p>Created {{when .Body.CreatedAt}}</p>
  <ul class="links">{{range .Body.Proposal.Operation.Effects}}<li>{{effect .Kind}}<span>{{target .Target}}</span></li>{{end}}</ul>
</section>
{{template "end" .}}
{{end}}
